<?xml version="1.0" encoding="utf-8"?>
<!--
  TESTING ONLY. Release builds block cleartext (ws://, http://) by default, which
  makes answering fail when the LiveKit push URL is a plain ws:// on a raw IP.
  This permits cleartext to ONLY the LiveKit test host below — not app-wide.
  PRODUCTION: serve LiveKit over wss:// (TLS) and delete this file + the
  android:networkSecurityConfig reference in AndroidManifest.xml.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">139.84.133.75</domain>
    </domain-config>
</network-security-config>
