# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Disable the New Architecture for this example so react-native-webrtc and
# react-native-incall-manager build through their well-tested old-architecture
# path. Remove this line (and re-run pod install) to test the New Architecture.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PiopiyRNExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'PiopiyRNExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ---- fmt / Xcode 26 (Apple Clang 21) compatibility ------------------
    # React Native 0.76 vendors fmt 11.0.2, whose base.h enables C++20
    # `consteval` for modern compilers. Apple Clang 21 evaluates consteval
    # calls more strictly and rejects fmt's own format-string helpers with
    # "call to consteval function ... is not a constant expression", which
    # breaks the `fmt` pod (and anything that includes its headers, e.g.
    # folly). base.h hard-codes FMT_USE_CONSTEVAL — it is NOT overridable
    # with a -D flag (the header redefines it, which fails under -Werror) —
    # so we patch the vendored header to turn consteval off. This only
    # downgrades compile-time format-string checks to runtime; otherwise safe.
    # Idempotent, and re-applied on every `pod install`.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      patched = original.gsub(/^#\s*define FMT_USE_CONSTEVAL 1\b/, '#  define FMT_USE_CONSTEVAL 0')
      if patched != original
        # fmt ships its headers read-only (0444); make writable before patching.
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
        File.chmod(0444, fmt_base)
        Pod::UI.puts '[piopiy] Patched fmt base.h: FMT_USE_CONSTEVAL -> 0 (Xcode 26 / Clang 21 fix)'.green
      end
    end
    # ---------------------------------------------------------------------
  end
end
